# Copie para .env (nunca vai para o Git) e preencha.
# Fila de espera: com SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY grava no Supabase; sem elas, em .runtime/lista.jsonl.
# A chave de serviço nunca vai para o navegador nem para variável PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RENDER_API_KEY=
# Gelato (cotação e pedidos de impressão). Só servidor.
GELATO_API_KEY=
# DIMONA_API_KEY=
# Stripe (modo de teste: sk_test_/pk_test_). Recomendado: chave restrita (rk_) só com Checkout Sessions e leitura de eventos.
STRIPE_SECRET_API_KEY=
STRIPE_PUBLIC_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Liga a compra no site (preços ainda provisórios em apps/web/lib/precos.ts).
CHECKOUT_ATIVO=false
SITE_URL=http://localhost:3000
# Pós-pagamento (EXP-317, docs/08_AUTOMACAO.md)
# Segredo (32+ caracteres) que o agendador do banco usa em POST /api/tarefas/processar.
TAREFAS_SEGREDO=
# E-mail de entrega pelo Resend. Sem domínio verificado, use "INFLEXO <onboarding@resend.dev>" (só entrega na caixa do dono da conta).
RESEND_API_KEY=
EMAIL_REMETENTE=
